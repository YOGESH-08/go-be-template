# Application Configuration
ENV=development
PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=go_template_db
POSTGRES_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Allowed CORS Origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3067

# Goose CLI Configuration (for running CLI migrations directly)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:CHANGE_ME@localhost:5432/go_template_db?sslmode=disable
